# Copiá este archivo a .env.local y completá. NUNCA subas .env.local a GitHub.
# Supabase → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://quoulqnroerzxlwvekho.supabase.co
# "Publishable key" (sb_publishable_...). Si tu panel muestra la legacy "anon", sirve igual.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (sb_secret_...) o la legacy "service_role". SOLO servidor: saltea RLS.
SUPABASE_SECRET_KEY=

# Producto de este deploy (tabla `productos`) y días de prueba
NEXT_PUBLIC_PRODUCTO_SLUG=repunte
NEXT_PUBLIC_DIAS_PRUEBA=14
